# SQLite 파일 경로 (prisma/ 디렉터리 기준)
DATABASE_URL="file:./dev.db"

# 세션 쿠키 서명용 비밀키. 운영 환경에서는 반드시 32자 이상의 무작위 값으로 변경하세요.
# 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="dev-only-change-me-please-change-in-production-1234567890"

# 증적파일 저장 디렉터리 (웹 루트 밖)
UPLOAD_DIR="./storage/uploads"

# 최초 관리자 계정 (npm run db:seed 실행 시 생성/갱신)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="개인정보 보호담당자"
